<form class="editable flexcol" autocomplete="off">
  <!-- Link must be relative to the foundry project -->
  <link
    rel="stylesheet"
    href="modules/bd-card-tools/templates/bd-card-tools.css"
    type="text/css"
  />
  <section class="flex1 title" >
    <p>{{title}}</p>
  </section>
  <section class="flex3">
    <div id="tarotDisplay" class = "center">
      <img id="tarotImg" class = "center-fit" src = {{img}}></img>
    </div>
  </section>
  <section class="flex1 description" ><p>{{desc}}</p></section>
</form>


