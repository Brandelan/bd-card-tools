{
  "compilerOptions": {
    "types": ["@league-of-foundry-developers/foundry-vtt-types", "pixi.js"],
    "target": "ESNext",
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "sourceMap": true,
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "esModuleInterop": true,
    //"noEmit": true,
    "resolveJsonModule": true,

    //"rootDir": "./src/",
    "outDir": "./dist/",

    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false
  },

  //"files": ["src/foundry-map-gen.ts"]
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
